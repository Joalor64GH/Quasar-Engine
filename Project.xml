<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://lime.openfl.org/project/1.0.4" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" 
	xsi:schemaLocation="http://lime.openfl.org/project/1.0.4 http://lime.openfl.org/xsd/project-1.0.4.xsd">

	<!-- _________________________ Application Settings _________________________ -->

	<app title="Friday Night Funkin': Quasar Engine" file="Quasar Engine" package="com.joalor64gh.quasar" main="Main" version="1.0.0" company="Joalor64" />

	<set name="SWF_VERSION" value="11.8" />

	<!-- ____________________________ Window Settings ___________________________ -->

	<!--All targets-->
	<window width="1280" height="720" fps="60" orientation="landscape" background="#000000" hardware="true" vsync="false" allow-shaders="true" require-shaders="true" />

	<!--HTML5-->
	<window if="html5" resizable="true" />

	<!--Desktop-->
	<window if="desktop" fullscreen="false" resizable="true" allow-high-dpi="true" />

	<!--Mobile-->
	<window if="mobile" fullscreen="true" resizable="false" allow-high-dpi="true" />

	<!-- ______________________________ Engine Defines _____________________________ -->

	<!-- COMMENT THESE TO DISABLE THEM -->
	<section if="desktop">
		<define name="FUTURE_DISCORD_RCP" />
		<define name="FUTURE_POLYMOD" />
	</section>
	<define name="FUTURE_VIDEO" if="windows || web" unless="32bits" />

	<!-- _____________________________ Path Settings ____________________________ -->

	<set name="BUILD_DIR" value="export/debug" if="debug" />
	<set name="BUILD_DIR" value="export/release" unless="debug" />

	<source name="source" />
	<assets path="assets" />
	<assets path="mods" if="FUTURE_POLYMOD" />
	<assets path="assets/videos" library="videos" if="FUTURE_VIDEO" />

	<!-- _______________________________ Libraries ______________________________ -->

	<haxelib name="flixel" />
	<haxelib name="flixel-ui" />
	<haxelib name="flixel-addons" />
	<haxelib name="hxCodec" if="FUTURE_VIDEO" />
	<haxelib name="hscript"/>
	<haxelib name="linc_discord-rpc" if="FUTURE_DISCORD_RCP" />
	<haxelib name="polymod" if="FUTURE_POLYMOD" />
	<haxelib name="hxcpp-debug-server" if="desktop debug" />

	<!-- ______________________________ Haxe Defines _____________________________ -->

	<!--Disable the Flixel core focus lost screen-->
	<haxedef name="FLX_NO_FOCUS_LOST_SCREEN" />

	<!-- hxCodec Debug Stuff -->
	<haxedef name="HXC_DEBUG_TRACE" if="debug" />
	<haxedef name="HXC_LIBVLC_LOGGING" if="FUTURE_VIDEO debug" />

	<section unless="debug">
		<!--Disable the Flixel core debugger. Automatically gets set whenever you compile in release mode!-->
		<haxedef name="FLX_NO_DEBUG" />

		<!--Enable this for Nape release builds for a serious peformance improvement-->
		<haxedef name="NAPE_RELEASE_BUILD" />

		<section if="cpp">
			<!--Allow working memory greater than 1 gigabyte-->
			<haxedef name="HXCPP_GC_BIG_BLOCKS" />

			<!--Include line information in stack traces, even in release mode-->
			<haxedef name="HXCPP_STACK_LINE" />

			<!--Add null-pointer checks, even in release mode-->
			<haxedef name="HXCPP_CHECK_POINTER" />
		</section>
	</section>
	
	<section if="polymod">
		<haxedef name="POLYMOD_DEBUG" value="true" if="debug" />
		<haxedef name="POLYMOD_SCRIPT_EXT" value=".hx" /> <!-- Da Script Extension for Polymod -->
	</section>

	<!--The Name Says what will do-->
	<haxedef name="no-deprecation-warnings" />

	<haxedef name="hscriptPos" />
	<haxedef name="analyzer-optimize" />
	<haxedef name="message.reporting" value="pretty" />

	<!-- ______________________________ Haxe Flags _____________________________ -->

	<!--No DCE is performed-->
	<haxeflag name="-dce no" />

	<haxeflag name="--macro" value="allowPackage('flash')" />

	<!--Hscript Power go brrr-->
	<haxeflag name="--macro" value="include('flixel', true, ['flixel.addons.editors.spine.*', 'flixel.addons.nape.*', 'flixel.system.macros.*'])" />

	<!-- _________________________________ Custom _______________________________ -->

	<!--Place custom nodes like icons here (higher priority to override the HaxeFlixel icon)-->
	
	<icon path="icon.png" />

</project>